# ─── LLM Configuration ──────────────────────────────────────────────────────
# Set USE_LOCAL_LLM=True to run locally via Ollama (no Groq API key needed)
# Set USE_LOCAL_LLM=False to use cloud Groq API
USE_LOCAL_LLM=False
GROQ_API_KEY=your_groq_api_key_here
LOCAL_LLM_MODEL=llama3.1
LOCAL_LLM_URL=http://localhost:11434

# ─── Vector Database Configuration ──────────────────────────────────────────
# Set VECTOR_DB_TYPE=pinecone for cloud vector store
# Set VECTOR_DB_TYPE=chroma for local vector store (no Pinecone key needed)
VECTOR_DB_TYPE=pinecone
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=research-assistant
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_DB_DIR=db/chroma_db

# ─── Storage Configuration (AWS S3 vs Local Disk) ───────────────────────────
# Set USE_S3=True to persist user files to AWS S3 vault
# Set USE_S3=False to save user files on local disk (research-assistant/backend/media/)
USE_S3=False
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_STORAGE_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=ap-south-1

# ─── Django & Database ──────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-replace-with-a-secure-secret-key
DEBUG=True
# DATABASE_URL: leave commented or empty for local SQLite (db.sqlite3)
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Email Setup (Gmail SMTP) ───────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password
DEFAULT_FROM_EMAIL=GraphLens AI <your_email@gmail.com>
